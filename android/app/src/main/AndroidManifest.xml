<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M09：网络书源在 debug/profile/release 三种构建中都必须具备联网权限。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- M5：扫一扫导入书源只在扫码页面申请相机权限。 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- P1-05：Android 串行离线下载使用数据同步前台服务维持后台运行。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 13+ 首次后台下载时由宿主动态申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 服务端 APK 校验完成后只交给系统安装器；iOS 不声明等价能力。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- M5：相机是可选能力，无摄像头设备仍可安装并使用文件或剪贴板导入。 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <application
        android:label="Legado Flutter"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- M08.1：外部文件 Uri 只交给自有 TXT 通道，禁止 Flutter 再把 content:// 当页面路由。 -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- M08.1：接收 MIME 正确的 TXT“打开方式”请求。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- M08.1：兼容 MIME 不准确但 Uri 路径仍携带 TXT 扩展名的文件提供方。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="*/*"/>
                <data android:pathAdvancedPattern=".*\\.[tT][xX][tT]"/>
                <data android:pathPattern=".*\\.txt"/>
                <data android:pathPattern=".*\\.TXT"/>
            </intent-filter>
        </activity>
        <!-- P1-05：只承载下载通知和进程优先级，章节状态机仍由 Dart 单例协调器管理。 -->
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <!-- 只向系统安装器临时授权读取 cache/app_updates 下已校验的 APK。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.app_update_files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/app_update_file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
